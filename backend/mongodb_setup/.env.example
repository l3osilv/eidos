# Copia questo file in backend/.env e personalizza i valori.

MONGODB_URL=mongodb://localhost:27017
DB_NAME=medicinai

# Path alla repo SSL-BrainCT-Pathology (necessaria per il Modello I).
# Il default assume che sia affiancata a questa nella struttura delle cartelle.
SSL_BRAINCT_SRC=../../SSL-BrainCT-Pathology/stage2_2d_slice_level/supervised_finetuning

# Genera una stringa random, non lasciare il placeholder.
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_QUESTO_VALORE_CON_UNA_STRINGA_RANDOM

IMAGES_ROOT=storage/images

# Rifinitura linguistica del referto via Anthropic API (opzionale).
# Se la chiave non è impostata, il referto resta quello rule-based.
ANTHROPIC_API_KEY=
ENABLE_LLM_REFINEMENT=false
