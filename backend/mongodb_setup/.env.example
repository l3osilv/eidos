# Copiare questo file in backend/.env e personalizzare i valori.

MONGODB_URL=mongodb://localhost:27017
DB_NAME=eidos

# Percorso alla repository SSL-BrainCT-Pathology (necessaria per il modello I).
# Il valore predefinito assume che sia affiancata a questa nella struttura delle cartelle.
SSL_BRAINCT_SRC=../../SSL-BrainCT-Pathology/stage2_2d_slice_level/supervised_finetuning

# Generare una chiave segreta sicura:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_QUESTO_VALORE_CON_UNA_STRINGA_CASUALE

IMAGES_ROOT=storage/images

# Rifinitura linguistica del referto tramite API Groq (modello LLaMA 3.3).
# Se la chiave non è impostata, il referto mantiene la bozza deterministica basata su template.
GROQ_API_KEY=
ENABLE_LLM_REFINEMENT=true
